        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    U[\&quot;User / Browser\&quot;]\n    DNS[\&quot;DNS Server&lt;br/&gt;www.foobar.com&lt;br/&gt;A Record: Load Balancer IP\&quot;]\n\n    U --&gt;|\&quot;DNS Lookup\&quot;| DNS\n    DNS --&gt;|\&quot;Returns IP Address\&quot;| U\n\n    subgraph S1[\&quot;SERVER 1 - LOAD BALANCER\&quot;]\n        FW1[\&quot;Firewall 1\&quot;]\n        LB[\&quot;HAProxy Load Balancer&lt;br/&gt;Round Robin / Active-Active\&quot;]\n        SSL[\&quot;SSL/TLS Certificate&lt;br/&gt;HTTPS Termination\&quot;]\n        MON1[\&quot;Monitoring Client 1&lt;br/&gt;Metrics and Logs\&quot;]\n\n        FW1 --&gt; LB\n        LB --- SSL\n        MON1 -.-&gt; LB\n    end\n\n    U --&gt;|\&quot;HTTPS / TCP 443\&quot;| FW1\n\n    subgraph S2[\&quot;SERVER 2 - WEB / APPLICATION\&quot;]\n        FW2[\&quot;Firewall 2\&quot;]\n        WEB2[\&quot;Nginx Web Server\&quot;]\n        APP2[\&quot;Application Server\&quot;]\n        CODE2[\&quot;Application Files&lt;br/&gt;Code Base\&quot;]\n        DB2[(\&quot;MySQL Primary Database\&quot;)]\n        MON2[\&quot;Monitoring Client 2&lt;br/&gt;Metrics and Logs\&quot;]\n\n        FW2 --&gt; WEB2\n        WEB2 --&gt; APP2\n        APP2 --&gt; CODE2\n        APP2 &lt;--&gt; DB2\n        MON2 -.-&gt; WEB2\n    end\n\n    subgraph S3[\&quot;SERVER 3 - WEB / APPLICATION\&quot;]\n        FW3[\&quot;Firewall 3\&quot;]\n        WEB3[\&quot;Nginx Web Server\&quot;]\n        APP3[\&quot;Application Server\&quot;]\n        CODE3[\&quot;Application Files&lt;br/&gt;Code Base\&quot;]\n        DB3[(\&quot;MySQL Replica Database\&quot;)]\n        MON3[\&quot;Monitoring Client 3&lt;br/&gt;Metrics and Logs\&quot;]\n\n        FW3 --&gt; WEB3\n        WEB3 --&gt; APP3\n        APP3 --&gt; CODE3\n        APP3 &lt;--&gt; DB3\n        MON3 -.-&gt; WEB3\n    end\n\n    LB --&gt;|\&quot;HTTP - Request Distribution\&quot;| FW2\n    LB --&gt;|\&quot;HTTP - Request Distribution\&quot;| FW3\n\n    DB2 --&gt;|\&quot;MySQL Replication\&quot;| DB3\n\n    MON1 -.-&gt;|\&quot;Monitoring Data\&quot;| MS\n    MON2 -.-&gt;|\&quot;Monitoring Data\&quot;| MS\n    MON3 -.-&gt;|\&quot;Monitoring Data\&quot;| MS\n\n    MS[\&quot;Monitoring Service&lt;br/&gt;Sumo Logic\&quot;]\n\n    style S1 fill:#dceeff,stroke:#2980b9\n    style S2 fill:#f3e5f5,stroke:#8e44ad\n    style S3 fill:#e8f5e9,stroke:#27ae60\n    style DNS fill:#fff3cd,stroke:#d4a017\n    style MS fill:#fff3cd,stroke:#d4a017&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="k0NHyv-UXgiBoXlW7T-S-42">
